  <style>
        /* Watermark only inside the Things I Like card */
        .card#likes {
            position: relative;
            isolation: isolate;
            overflow: hidden;
        }

        .card#likes::before {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 0;
            background-image: url("data:image/jpeg;base64,");
            background-repeat: no-repeat;
            background-position: center;
            background-size: contain;
            opacity: 0.13;
            pointer-events: none;
        }

        .card#likes > * {
            position: relative;
            z-index: 1;
        }
    /*keep the watermark faint while the text remains readable */
</style>
